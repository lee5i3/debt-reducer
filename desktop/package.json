{
  "name": "debt-reducer-desktop",
  "productName": "Debt Reducer",
  "version": "0.1.0",
  "description": "Debt Reducer desktop app",
  "private": true,
  "main": "main.js",
  "desktopName": "debt-reducer.desktop",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.github.lee5i3.debtreducer",
    "productName": "Debt Reducer",
    "directories": {
      "output": "../bin/dist"
    },
    "files": [
      "main.js",
      "menu.js",
      "preload.js",
      "data.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bin/desktop/${os}-${arch}",
        "to": "server"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}
