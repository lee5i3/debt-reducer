package views

import "github.com/lee5i3/debt-reducer/internal/debt"

templ Index(d IndexData) {
	@Layout("Plan · Debt Reducer", "plan") {
		<div class="page-head">
			<h1>Payoff plan</h1>
			<p class="muted">
				{ itoa(len(d.Debts)) } debts · { d.TotalBalance.String() } owed · { d.MinimumTotal.String() }/mo in minimums
			</p>
		</div>
		if len(d.Debts) == 0 {
			<div class="empty">
				<p>You haven't added any debts yet.</p>
				<a class="button" href="/debts">Add your first debt</a>
			</div>
		} else {
			@controls(d)
			@alerts(d.Error, d.Notice)
			if d.Plan != nil {
				@summaryCards(d.Plan, d.Baseline)
				@payoffOrder(d.Plan)
			}
			if len(d.Comparison) > 0 {
				@comparison(d)
			}
			if d.Plan != nil {
				@schedule(d.Plan)
			}
		}
	}
}

templ controls(d IndexData) {
	<form class="controls" method="get" action="/">
		<label>
			Strategy
			<select name="strategy">
				for _, s := range debt.Strategies {
					<option value={ string(s) } selected?={ s == d.Strategy }>{ s.Label() }</option>
				}
			</select>
		</label>
		<label>
			Monthly budget
			<input type="number" name="budget" step="0.01" min="0" value={ dollars(d.MonthlyBudget) }/>
		</label>
		<label>
			Start date
			<input type="date" name="start" value={ isoDate(d.StartDate) }/>
		</label>
		<button type="submit">Calculate</button>
		<button type="submit" class="secondary" formmethod="post" formaction="/settings" title="Save strategy and budget as your defaults">Save as default</button>
	</form>
}

templ summaryCards(p *debt.Plan, baseline *debt.Plan) {
	<section class="cards">
		@card("hero", "Debt free", monthYear(p.DebtFreeDate), "last payment "+date(p.DebtFreeDate))
		@card("", "Time to payoff", duration(p.Months), itoa(p.Months)+" payments")
		@card("", "Total interest", p.TotalInterest.String(), "of "+p.TotalPaid.String()+" paid")
		if baseline != nil && p.Strategy != debt.MinimumOnly {
			@card("good", "Saved vs. minimums", (baseline.TotalInterest - p.TotalInterest).String(),
				duration(baseline.Months)+" → "+duration(p.Months))
		}
	</section>
}

templ card(variant, label, value, note string) {
	<div class={ "card", variant }>
		<span class="label">{ label }</span>
		<strong>{ value }</strong>
		<span class="muted">{ note }</span>
	</div>
}

templ payoffOrder(p *debt.Plan) {
	<section>
		<h2>Payoff order <span class="muted">({ p.Strategy.Label() })</span></h2>
		<table>
			<thead>
				<tr>
					<th>#</th>
					<th>Debt</th>
					<th class="num">Balance</th>
					<th class="num">APR</th>
					<th>Paid off</th>
					<th class="num">Interest</th>
					<th class="num">Total paid</th>
				</tr>
			</thead>
			<tbody>
				for _, s := range p.Debts {
					<tr>
						<td>{ itoa(s.PayoffOrder) }</td>
						<td>{ s.Name }</td>
						<td class="num">{ s.StartingBalance.String() }</td>
						<td class="num">{ percent(s.APR) }</td>
						<td>{ date(s.PayoffDate) } <span class="muted">({ duration(s.Months) })</span></td>
						<td class="num">{ s.TotalInterest.String() }</td>
						<td class="num">{ s.TotalPaid.String() }</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}

templ comparison(d IndexData) {
	<section>
		<h2>Strategy comparison</h2>
		<table>
			<thead>
				<tr>
					<th>Strategy</th>
					<th class="num">Monthly</th>
					<th>Debt free</th>
					<th class="num">Months</th>
					<th class="num">Interest</th>
					<th class="num">Total paid</th>
				</tr>
			</thead>
			<tbody>
				for _, p := range d.Comparison {
					<tr class={ templ.KV("selected", p.Strategy == d.Strategy) }>
						<td><a href={ strategyURL(d, p.Strategy) }>{ p.Strategy.Label() }</a></td>
						<td class="num">{ p.MonthlyBudget.String() }</td>
						<td>{ date(p.DebtFreeDate) }</td>
						<td class="num">{ itoa(p.Months) }</td>
						<td class="num">{ p.TotalInterest.String() }</td>
						<td class="num">{ p.TotalPaid.String() }</td>
					</tr>
				}
				if d.Baseline == nil {
					<tr>
						<td>{ debt.MinimumOnly.Label() }</td>
						<td colspan="5" class="muted">Never paid off — minimums don't cover interest.</td>
					</tr>
				}
			</tbody>
		</table>
	</section>
}

templ schedule(p *debt.Plan) {
	<section>
		<h2>Payment schedule</h2>
		<div class="schedule">
			for _, m := range p.Schedule {
				<details>
					<summary>
						<span class="month"><span class="muted">#{ itoa(m.Number) }</span> { period(m) }</span>
						<span class="num">{ m.TotalPaid.String() }</span>
						<span class="num muted">interest { m.TotalInterest.String() }</span>
						<span class="num">left { m.RemainingBalance.String() }</span>
					</summary>
					<table>
						<thead>
							<tr>
								<th>Due</th>
								<th>Debt</th>
								<th class="num">Payment</th>
								<th class="num">Interest</th>
								<th class="num">Principal</th>
								<th class="num">Remaining</th>
							</tr>
						</thead>
						<tbody>
							for _, pay := range m.Payments {
								<tr class={ templ.KV("paidoff", pay.PaidOff) }>
									<td>{ date(pay.Date) }</td>
									<td>
										{ pay.Debt }
										if pay.PaidOff {
											<span class="tag">paid off</span>
										}
									</td>
									<td class="num">{ pay.Amount.String() }</td>
									<td class="num">{ pay.Interest.String() }</td>
									<td class="num">{ pay.Principal.String() }</td>
									<td class="num">{ pay.Remaining.String() }</td>
								</tr>
							}
						</tbody>
					</table>
				</details>
			}
		</div>
	</section>
}
