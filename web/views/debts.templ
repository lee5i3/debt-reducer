package views

templ DebtsPage(d DebtsData) {
	@Layout("Debts · Debt Reducer", "debts") {
		<div class="page-head">
			<h1>Debts</h1>
			<p class="muted">{ itoa(len(d.Debts)) } debts · { d.TotalBalance.String() } owed · { d.MinimumTotal.String() }/mo in minimums</p>
		</div>
		@alerts("", d.Notice)
		<div class="split">
			<section>
				if len(d.Debts) == 0 {
					<div class="empty">No debts yet. Add your first one with the form.</div>
				} else {
					<table>
						<thead>
							<tr>
								<th>Name</th>
								<th class="num">Balance</th>
								<th class="num">APR</th>
								<th class="num">Minimum</th>
								<th>Due</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							for _, debt := range d.Debts {
								<tr class={ templ.KV("selected", debt.ID == d.Form.ID) }>
									<td>{ debt.Name }</td>
									<td class="num">{ debt.Balance.String() }</td>
									<td class="num">{ percent(debt.APR) }</td>
									<td class="num">{ debt.MinimumPayment.String() }</td>
									<td>{ ordinal(debt.DueDay) }</td>
									<td>
										<div class="actions">
											<a href={ debtURL(debt.ID, "/edit") }>Edit</a>
											<form method="post" action={ debtURL(debt.ID, "/delete") } onsubmit="return confirm('Delete this debt?')">
												<button type="submit" class="link danger">Delete</button>
											</form>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</section>
			@debtForm(d.Form)
		</div>
	}
}

templ debtForm(f DebtForm) {
	<form class="panel stack" method="post" action={ formAction(f) }>
		<h2>
			if f.Editing() {
				Edit debt
			} else {
				Add a debt
			}
		</h2>
		@alerts(f.Error, "")
		<label>
			Name
			<input name="name" required maxlength="100" value={ f.Name } placeholder="Visa"/>
		</label>
		<label>
			Balance ($)
			<input name="balance" type="number" step="0.01" min="0.01" required value={ f.Balance } placeholder="4500.00"/>
		</label>
		<label>
			APR (%)
			<input name="apr" type="number" step="0.01" min="0" required value={ f.APR } placeholder="24.99"/>
		</label>
		<label>
			Minimum payment ($)
			<input name="minimum_payment" type="number" step="0.01" min="0.01" required value={ f.MinimumPayment } placeholder="120.00"/>
		</label>
		<label>
			Due day of month
			<input name="due_day" type="number" min="1" max="31" required value={ f.DueDay }/>
		</label>
		<div class="row">
			<button type="submit">
				if f.Editing() {
					Save changes
				} else {
					Add debt
				}
			</button>
			if f.Editing() {
				<a href="/debts">Cancel</a>
			}
		</div>
	</form>
}

func formAction(f DebtForm) templ.SafeURL {
	if f.Editing() {
		return debtURL(f.ID, "")
	}
	return templ.SafeURL("/debts")
}
