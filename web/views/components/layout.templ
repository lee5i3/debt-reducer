package components

import (
	"strconv"

	"github.com/lee5i3/debt-reducer/internal/version"
)

templ Layout(s Shell, title string) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ s.ThemeName() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content={ s.ThemeName() }/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/vendor/phosphor/regular.css"/>
			<link rel="icon" type="image/svg+xml" href="/static/icon.svg"/>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body data-notice-seconds={ strconv.Itoa(s.NoticeSeconds) }>
			<div class="shell">
				<aside class="sidebar">
					<a class="brand" href="/">Debt Reducer</a>
					<nav class="side-nav" aria-label="Main">
						if s.CanPlan() {
							<a href="/" class="nav-item" aria-current={ Current(s.Active == "plan") }>
								@IconPlan()
								Plan
							</a>
							<a href="/simulate" class="nav-item" aria-current={ Current(s.Active == "simulate") }>
								@IconBolt()
								Simulate
							</a>
						} else {
							<span class="nav-item" aria-disabled="true" title="Add a debt to see your plan">
								@IconPlan()
								Plan
							</span>
							<span class="nav-item" aria-disabled="true" title="Add a debt to try changes">
								@IconBolt()
								Simulate
							</span>
						}
						<a href="/debts" class="nav-item" aria-current={ Current(s.Active == "debts") }>
							<span class="nav-label">
								@IconCard()
								Debts
							</span>
							if s.DebtCount > 0 {
								<span class="badge">{ strconv.Itoa(s.DebtCount) }</span>
							}
						</a>
					</nav>
					<div class="side-bottom">
						if s.DebtCount > 0 {
							<div class="side-summary">
								<span class="muted">Total owed</span>
								<strong>{ s.TotalOwed.String() }</strong>
								if s.InterestPaid+s.InterestAhead > 0 {
									<span class="side-interest" title={ s.InterestPaid.String() + " paid · " + s.InterestAhead.String() + " to come" }>
										+ { s.InterestAhead.String() } interest to come
									</span>
									if s.InterestPaid > 0 {
										<span class="muted">{ s.InterestPaid.String() } interest paid</span>
									}
								}
								if !s.DebtFree.IsZero() {
									<span class="muted">Debt free { s.DebtFree.Format("Jan 2006") }</span>
								}
							</div>
						}
						<a href={ templ.SafeURL(s.SettingsURL()) } class="nav-item" aria-current={ Current(s.Settings != nil) }>
							@IconSettings()
							Settings
						</a>
					</div>
				</aside>
				<div class="main-col">
					<main class="content">
						{ children... }
						if s.Settings != nil {
							@SettingsDialog(s)
						}
					</main>
				</div>
			</div>
			<footer class="app-footer">{ version.String() }</footer>
			<script>
				// Turn server-rendered dialogs into real modals: focus is trapped,
				// and Escape or a click on the backdrop goes back to the list.
				document.querySelectorAll("dialog[data-close]").forEach(function (d) {
					if (d.open) { d.close(); d.showModal(); }
					d.addEventListener("cancel", function (e) { e.preventDefault(); location.href = d.dataset.close; });
					d.addEventListener("click", function (e) { if (e.target === d) { location.href = d.dataset.close; } });
				});
				// Banners: the ✕ closes one; "saved" notices also close on their
				// own after the time set in Settings (0 keeps them open).
				document.addEventListener("click", function (e) {
					var b = e.target.closest("[data-dismiss]");
					if (b) { b.closest(".alert, .notice").remove(); }
				});
				(function () {
					var secs = parseInt(document.body.dataset.noticeSeconds || "0", 10);
					if (!(secs > 0)) { return; }
					document.querySelectorAll("[data-autoclose]").forEach(function (n) {
						setTimeout(function () {
							n.classList.add("is-leaving");
							setTimeout(function () { n.remove(); }, 200);
						}, secs * 1000);
					});
				})();
				// Amount boxes take numbers only: ignore letters and symbols
				// before they appear (pasted text is cleaned up below).
				document.addEventListener("beforeinput", function (e) {
					var el = e.target;
					if (!el.dataset || el.dataset.format !== "money" || e.data == null) { return; }
					if (e.inputType === "insertText" && /[^0-9.,]/.test(e.data)) { e.preventDefault(); }
				});
				// Amount boxes: add thousands separators as you type, keeping
				// the cursor in place; only digits and one "." with 2 decimals.
				document.addEventListener("input", function (e) {
					var el = e.target;
					if (!el.dataset || el.dataset.format !== "money") { return; }
					var raw = el.value;
					var caret = el.selectionStart == null ? raw.length : el.selectionStart;
					// Digits (and the ".") before the cursor tell us where it belongs afterwards.
					var before = raw.slice(0, caret).replace(/[^0-9.]/g, "").length;
					var clean = raw.replace(/[^0-9.]/g, "");
					var dot = clean.indexOf(".");
					var whole = dot === -1 ? clean : clean.slice(0, dot);
					var frac = dot === -1 ? null : clean.slice(dot + 1).replace(/\./g, "").slice(0, 2);
					whole = whole.replace(/^0+(?=\d)/, "").replace(/\B(?=(\d{3})+(?!\d))/g, ",");
					var out = frac === null ? whole : whole + "." + frac;
					if (out === raw) { return; }
					el.value = out;
					var pos = 0, seen = 0;
					while (pos < out.length && seen < before) {
						if (/[0-9.]/.test(out[pos])) { seen++; }
						pos++;
					}
					el.setSelectionRange(pos, pos);
				});
				// Amount and rate boxes: tidy to two decimals when you leave them
				// (data-format="money" adds thousands separators).
				document.addEventListener("focusout", function (e) {
					var el = e.target;
					if (!el.dataset || !el.dataset.format) { return; }
					var n = parseFloat(el.value.replace(/[$,%\s]/g, ""));
					if (!(n >= 0)) { return; }
					el.value = el.dataset.format === "money"
						? n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })
						: n.toFixed(2);
				});
				// Dropdown menus (plan status): close on a click outside, on
				// Escape, and when another menu opens.
				function closeMenus(except) {
					document.querySelectorAll("details.status-menu[open]").forEach(function (m) {
						if (m !== except) { m.open = false; }
					});
				}
				document.addEventListener("click", function (e) {
					closeMenus(e.target.closest ? e.target.closest("details.status-menu") : null);
				});
				document.addEventListener("keydown", function (e) {
					if (e.key !== "Escape") { return; }
					var open = document.querySelector("details.status-menu[open]");
					if (open) { open.open = false; open.querySelector("summary").focus(); }
				});
				// Settings popup: one section at a time, picked in the section list.
				// Search looks across all sections and shows what matches; clearing
				// it goes back to the picked section. In the desktop app the Data
				// buttons talk to it through window.debtReducer (preload.js).
				(function () {
					var list = document.querySelector("[data-settings-list]");
					if (!list) { return; }
					var search = document.querySelector("[data-settings-search]");
					var nav = document.querySelectorAll(".settings-nav a");
					var sections = list.querySelectorAll(".settings-section");
					var empty = list.querySelector("[data-settings-empty]");
					var current = "set-data";
					function showSection(id) {
						current = id;
						sections.forEach(function (sec) {
							sec.hidden = sec.id !== id;
							sec.querySelectorAll("[data-setting]").forEach(function (el) { el.hidden = false; });
						});
						nav.forEach(function (a) { a.setAttribute("aria-current", a.getAttribute("href") === "#" + id ? "true" : "false"); });
						empty.hidden = true;
						list.scrollTop = 0;
					}
					function filter(q) {
						var any = false;
						sections.forEach(function (sec) {
							var shown = 0;
							sec.querySelectorAll("[data-setting]").forEach(function (el) {
								var hit = el.textContent.toLowerCase().indexOf(q) >= 0;
								el.hidden = !hit;
								if (hit) { shown++; }
							});
							sec.hidden = shown === 0;
							if (shown) { any = true; }
						});
						nav.forEach(function (a) { a.setAttribute("aria-current", "false"); });
						empty.hidden = any;
					}
					search.addEventListener("input", function () {
						var q = search.value.trim().toLowerCase();
						if (q) { filter(q); } else { showSection(current); }
					});
					// Escape in a non-empty search clears it instead of closing.
					search.addEventListener("keydown", function (e) {
						if (e.key === "Escape" && search.value) {
							e.preventDefault(); e.stopPropagation();
							search.value = ""; showSection(current);
						}
					});
					nav.forEach(function (a) {
						a.addEventListener("click", function (e) {
							e.preventDefault();
							search.value = "";
							showSection(a.getAttribute("href").slice(1));
						});
					});
					showSection(current);

					var desk = window.debtReducer;
					if (!desk) { return; }
					list.querySelectorAll("[data-desktop]").forEach(function (el) { el.hidden = false; });
					list.querySelectorAll("[data-web]").forEach(function (el) { el.hidden = true; });
					var err = list.querySelector("[data-data-error]");
					function show(res) {
						err.hidden = !(res && res.error);
						err.textContent = (res && res.error) || "";
					}
					list.querySelector('[data-desktop="choose-data"]').addEventListener("click", function () {
						err.hidden = true;
						desk.chooseDataFolder().then(show, function () { show({ error: "The data folder couldn't be changed." }); });
					});
					list.querySelector('[data-desktop="open-data"]').addEventListener("click", function () {
						desk.openDataFolder().then(show);
					});
				})();
			</script>
		</body>
	</html>
}

// Alerts shows an error and/or a success notice.
// bannerClose is the ✕ on a banner (the layout script wires it up).
templ bannerClose() {
	<button type="button" class="banner-close" data-dismiss aria-label="Close message">
		@IconX()
	</button>
}

templ Alerts(errMsg, notice string) {
	if errMsg != "" {
		<div class="alert" role="alert">
			<span class="banner-text">{ errMsg }</span>
			@bannerClose()
		</div>
	}
	if notice != "" {
		<div class="notice" role="status" data-autoclose>
			@IconCheck()
			<span class="banner-text">{ notice }</span>
			@bannerClose()
		</div>
	}
}

// Modal is a dialog shown over the page; data-close is where Escape goes.
templ Modal(labelledBy, role, size, closeURL string) {
	<dialog class={ "modal", size } open role={ role } aria-labelledby={ labelledBy } data-close={ closeURL }>
		<div class="modal-inner">
			{ children... }
		</div>
	</dialog>
}

// Current is the aria-current value for a link: "page" when on.
func Current(on bool) string {
	if on {
		return "page"
	}
	return "false"
}
